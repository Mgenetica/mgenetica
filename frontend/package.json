{
  "name": "mgenetica-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/blog/editorial.mjs prepare && vite build && node scripts/render-blog.mjs",
    "start": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "build:drafts": "VITE_BLOG_DRAFTS=true npm run build",
    "blog:check": "node ../scripts/blog/editorial.mjs check",
    "blog:plan": "node ../scripts/blog/editorial.mjs plan"
  },
  "dependencies": {
    "appwrite": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "vite": "^8.0.16"
  }
}
